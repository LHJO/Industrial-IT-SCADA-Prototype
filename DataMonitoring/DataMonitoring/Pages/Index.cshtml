@page
@model IndexModel
@{
    ViewData["Title"] = "Data Monitoring";
}

<link rel="stylesheet" href="~/css/index.css" />

<div class="container dashboard-container">
    <h2 class="text-center text-uppercase fw-bold scada-title mb-4">SCADA Monitoring Dashboard</h2>

    <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-4">
        <div><strong>OPC Server:</strong> opc.tcp://LHsPC:49580</div>
        <div><strong>Tags:</strong> Process Value, Setpoint</div>
        <div>
            <div>
                <span class="d-inline-block bg-success rounded-circle me-1" id="connectionDot" style="width: 12px; height: 12px;"></span>
                <span class="fw-bold text-success" id="connectionText">Connected</span>
            </div>
        </div>
    </div>

    <div class="row">

        <!-- OPC Data Box -->
        <div class="col-md-6 mb-4">
            <div class="scada-panel h-100">
                <div class="scada-panel-header">
                    <h5 class="mb-0">Temperature Control</h5>
                </div>
                <div class="scada-panel-body d-flex flex-column align-items-center justify-content-center">
                    <div class="w-100 text-center mb-3">
                        <span class="scada-label d-block">Setpoint</span>
                        <div class="scada-value d-inline-block" id="sensor1Value">@Model.CurrentSetpoint &deg;C</div>
                    </div>
                    <div class="w-100 text-center mb-3">
                        <span class="scada-label d-block">Process Value</span>
                        <div class="scada-value d-inline-block" id="sensor1Feedback">@Model.CurrentFeedback &deg;C</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alarm System -->
        <div class="col-md-6 mb-4">
            <div class="scada-panel h-100 scada-panel-alarm">
                <div class="scada-panel-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Active Alarms</h5>
                </div>
                <div class="scada-panel-body p-0">
                    <!-- SCADA alarm table -->
                    <table class="scada-table mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Message</th>
                                <th>Severity</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="alarmTableBody">
                            <!-- Alarms -->
                        </tbody>
                    </table>
                </div>
                <div class="scada-panel-footer text-center">
                    System OK - Active events present
                </div>
            </div>
        </div>

    </div>
    <div class="row mt-4 mb-4 justify-content-center">
        <div class="col-lg-8 col-12">
        <div class="scada-panel">
            <div class="scada-panel-header">
                <h5 class="mb-0">Temperature Trend</h5>
            </div>
            <div class="scada-panel-body">
                <div style="position: relative; height: 400px; width: 100%;">
                    <canvas id="tempChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        const ctx = document.getElementById('tempChart').getContext('2d');

        const tempChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [
                    {
                        label: 'Setpoint (°C)',
                        data: [],
                        borderColor: 'rgb(54, 162, 235)', // Blue
                        backgroundColor: 'rgba(54, 162, 235, 0.1)',
                        tension: 0.25,
                        pointRadius: 0
                    },
                    {
                        label: 'Process Value (°C)',
                        data: [],
                        borderColor: 'rgb(255, 99, 132)', // Red
                        backgroundColor: 'rgba(255, 99, 132, 0.1)',
                        tension: 0.25,
                        pointRadius: 0
                    }
                ]
            },
            options: {
                animation: false,
                responsive: true,
                scales: {
                    x: { ticks: { maxTicksLimit: 10 } },
                    y: { title: { display: true, text: '°C' } }
                }
            }
        });

		function fetchLatestData() {
			fetch('?handler=LatestData')
				.then(response => response.json())
				.then(data => {

					// Update connection state
					const connectDot = document.getElementById('connectionDot');
					const connectText = document.getElementById('connectionText');

					if (data.isConnected) {
						connectDot.className = 'd-inline-block bg-success rounded-circle me-1';
						connectText.className = 'fw-bold text-success';
						connectText.innerText = 'Connected';
					} else {
						connectDot.className = 'd-inline-block bg-danger rounded-circle me-1';
						connectText.className = 'fw-bold text-danger';
						connectText.innerText = 'Not Connected';
					}

					// Update the displayed values
                    document.getElementById('sensor1Value').innerHTML = Number(data.setpoint).toFixed(2)  + ' &deg;C';
                    document.getElementById('sensor1Feedback').innerHTML = Number(data.feedback).toFixed(2) + ' &deg;C';

					// Add new data points to the chart
                    const time = new Date().toLocaleTimeString();

                    tempChart.data.labels.push(time);
                    
                    tempChart.data.datasets[0].data.push(data.setpoint);
                    tempChart.data.datasets[1].data.push(data.feedback);

                    if (tempChart.data.labels.length > 50) {
                        tempChart.data.labels.shift();
                        tempChart.data.datasets[0].data.shift();
                        tempChart.data.datasets[1].data.shift();
                    }

                    tempChart.update(); 

                    // Alarm logic
                    const alarmTableBody = document.getElementById('alarmTableBody');
                    const feedbackValue = parseFloat(Number(data.feedback).toFixed(2));
                    const alarmLimitHigh = 3.0; 
					const alarmLimitLow = 1.0;
					const warningLimitHigh = 35.0;
					const warningLimitLow = 2.0;

                    if (feedbackValue >= alarmLimitHigh)
                    {
                        alarmTableBody.innerHTML = `
                            <tr class="scada-row-alarm">
                                <td>${time}</td>
                                <td>Temp High (${feedbackValue} &deg;C)</td>
                                <td>High</td>
                                <td>
                                    <button class="scada-btn scada-btn-alarm" onclick="acknowledgeLocalAlarm(this)">Ack</button>
                                </td>
                            </tr>
                        `;
                    }
                    else if (feedbackValue <= alarmLimitLow)
                    {
                        alarmTableBody.innerHTML = `
                            <tr class="scada-row-alarm">
                                <td>${time}</td>
                                <td>Temperature Low (${feedbackValue} &deg;C)</td>
                                <td>High</td>
                                <td>
                                    <button class="scada-btn scada-btn-alarm" onclick="acknowledgeLocalAlarm(this)">Ack</button>
                                </td>
                            </tr>
                        `;
					}
                    else
                    {
						alarmTableBody.innerHTML = '';
						document.querySelector('.scada-panel-footer').textContent = '0';
                    }


                })
                .catch(error => {
                    console.error('Error fetching OPC data:', error);
                    const connectDot = document.getElementById('connectionDot');
                    const connectText = document.getElementById('connectionText');
                    if(connectDot && connectText) {
                        connectDot.className = 'd-inline-block bg-danger rounded-circle me-1';
                        connectText.className = 'fw-bold text-danger';
                        connectText.innerText = 'Not Connected';
                    }
                });
        }

        setInterval(fetchLatestData, 500);

            const alarmState = {
            tempHigh: { active: false, acknowledged: false, time: null, message: '', severity: 'High' },
            tempLow: { active: false, acknowledged: false, time: null, message: '', severity: 'High' },
            tempWarningHigh: { active: false, acknowledged: false, time: null, message: '', severity: 'Medium' },
            tempWarningLow: { active: false, acknowledged: false, time: null, message: '', severity: 'Medium' }
        };
    </script>
}
